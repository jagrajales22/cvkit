{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jagrajales22/cvkit/schema/profile.schema.json",
  "title": "cvkit profile",
  "description": "Modular, evidence-backed career data. Merged from every YAML file under profile/.",
  "type": "object",
  "required": ["identity"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "timezone": { "type": "string" },
        "links": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "work_authorization": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "headlines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "tags": { "$ref": "#/$defs/tags" },
          "use_when": { "type": "string" }
        }
      }
    },

    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "tags": { "$ref": "#/$defs/tags" },
          "atoms": {
            "description": "Atom ids whose claims this summary repeats. Inherits their verification status.",
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "org", "title", "start"],
        "properties": {
          "id": { "type": "string" },
          "org": { "type": "string" },
          "org_note": { "type": "string", "description": "e.g. 'a Visa solution', 'contract via Forte Group'" },
          "title": { "type": "string", "description": "Title shown on the CV for this block" },
          "location": { "type": "string" },
          "start": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$" },
          "end": { "type": "string", "pattern": "^([0-9]{4}(-[0-9]{2})?|present)$" },
          "kind": { "enum": ["employment", "contract", "freelance", "volunteer"], "default": "employment" },
          "progression": {
            "description": "Internal title history. Rendered as a sub-line so promotions stay visible.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "start"],
              "properties": {
                "title": { "type": "string" },
                "start": { "type": "string" },
                "end": { "type": "string" },
                "org": { "type": "string" }
              }
            }
          },
          "scope": { "type": "string", "description": "One line of context: team size, systems, markets" },
          "tags": { "$ref": "#/$defs/tags" },
          "atoms": { "type": "array", "items": { "$ref": "#/$defs/atom" } }
        }
      }
    },

    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "text": { "type": "string" },
          "tags": { "$ref": "#/$defs/tags" }
        }
      }
    },

    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "items"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } },
          "tags": { "$ref": "#/$defs/tags" }
        }
      }
    },

    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "credential"],
        "properties": {
          "id": { "type": "string" },
          "credential": { "type": "string" },
          "institution": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "kind": { "enum": ["degree", "certification", "course"], "default": "degree" },
          "tags": { "$ref": "#/$defs/tags" }
        }
      }
    },

    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "string" }
        }
      }
    },

    "evidence": {
      "description": "The ledger. An atom may only claim what an entry here supports.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "source"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "description": "The fact, stated plainly" },
          "baseline": { "type": "string" },
          "result": { "type": "string" },
          "period": { "type": "string" },
          "source": { "type": "string", "description": "Where this is written down. 'memory' is not a source." },
          "defensible": {
            "type": "boolean",
            "default": false,
            "description": "Would you defend this number under questioning? Strict builds require true."
          },
          "recorded": { "type": "string", "format": "date" }
        }
      }
    }
  },

  "$defs": {
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form selectors: #ai, #leadership, #metric, #eu, #hands-on"
    },
    "atom": {
      "description": "One atomic, selectable claim. The unit the selection engine works with.",
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "tags": { "$ref": "#/$defs/tags" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence ids backing this atom. Required for status: verified."
        },
        "status": {
          "enum": ["verified", "unverified", "draft"],
          "default": "unverified",
          "description": "verified = every referenced evidence entry is defensible. Enforced at build, not declared."
        },
        "weight": {
          "type": "number",
          "default": 1,
          "description": "Tie-breaker when selection is over budget. Higher wins."
        },
        "pinned": {
          "type": "boolean",
          "default": false,
          "description": "Always include, regardless of target match."
        }
      }
    }
  }
}
